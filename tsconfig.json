{
  "compilerOptions": {
    "esModuleInterop": true,
    "declaration": true,
    "outDir": "./dist",
    "rootDir": "./src",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "target": "ES2022",
    "strict": true,
    "types": [
      "node"
    ],
    "skipLibCheck": true
  },
  "include": [
    "./src/**/*.mts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "./src/**/*.test.mts"
  ]
}
