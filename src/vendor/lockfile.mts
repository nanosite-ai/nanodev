}

export interface Lockfile {
  name?: string;
  version?: string;
  lockfileVersion: number;
  requires?: boolean;
  packages: Record<string, LockfilePackage>;
  [key: string]: unknown;
}

/** Oldest lockfile format we can read: v2 introduced the flat `packages` map. */
export const MIN_LOCKFILE_VERSION = 2;

/** Narrow unknown JSON to a v2/v3 lockfile (has a `packages` map with a root `""` entry). */
export const isLockfile = (value: unknown): value is Lockfile => {
  if (!value || typeof value !== "object") return false;
  const v = value as Partial<Lockfile>;
  return (
    typeof v.lockfileVersion === "number" &&
    v.lockfileVersion >= MIN_LOCKFILE_VERSION &&
    !!v.packages &&
    typeof v.packages === "object" &&
    !!v.packages[""]
  );
};

const NODE_MODULES = "node_modules/";

/** Package name of a lockfile path: `node_modules/a/node_modules/@s/b` → `@s/b`. */
export const packageNameFromPath = (lockPath: string): string => {
  const i = lockPath.lastIndexOf(NODE_MODULES);
  return i === -1 ? lockPath : lockPath.slice(i + NODE_MODULES.length);
};

/**
 * The package whose `node_modules` holds `lockPath`: `node_modules/a/node_modules/b` → `node_modules/a`,
 * `node_modules/a` or a workspace path `apps/x` → "" (the root), "" → null.
 */
const parentPackagePath = (lockPath: string): string | null => {
  if (lockPath === "") return null;
  const i = lockPath.lastIndexOf(NODE_MODULES);
  return i <= 0 ? "" : lockPath.slice(0, i - 1);
};

/**
 * Resolve dependency `name` from the package at `fromPath` the way Node does: its own `node_modules`,
 * then each enclosing package's, up to the top-level `node_modules`. Returns the lockfile path, or null.
 */
export const resolveLockfileDependency = (
  packages: Record<string, LockfilePackage>,
  fromPath: string,
  name: string,
): string | null => {
  let base: string | null = fromPath;
  while (base !== null) {
    const candidate = base ? `${base}/${NODE_MODULES}${name}` : `${NODE_MODULES}${name}`;
    if (packages[candidate]) return candidate;
    base = parentPackagePath(base);
  }
  return null;
};

/** A platform-specific optional dependency (native binding) whose Linux build the lockfile lacks. */
export interface MissingLinuxBinding {
  /** Lockfile path of the package that declares the binding, e.g. `node_modules/@rolldown/pluginutils`. */
  package: string;
  /** The binding package name, e.g. `@rolldown/binding-linux-x64-gnu`. */
  binding: string;
}

export interface LinuxInstallabilityResult {
  ok: boolean;
  missing: MissingLinuxBinding[];
}

/**
 * An optional dependency that is a Linux x64 native build our builders need: glibc (`*-linux-x64-gnu`,
 * `*-linux-x64`) AND musl (`*-linux-x64-musl`, sharp's `*-linuxmusl-x64`); the build servers are Alpine.
 * Other Linux architectures (arm64, arm, s390x, …) are not required: npm may legitimately not lock them.
 */
export const isRequiredLinuxBinding = (name: string): boolean =>
  /linux/i.test(name) && /(^|[-_/.])(x64|amd64|x86_64)([-_/.]|$)/i.test(name) && !/(arm|aarch|s390|ppc|riscv|loong|ia32|mips)/i.test(name);

/**
 * Can `npm ci` on Linux (our build servers) install this lockfile with every native binding present?
 *
 * npm on Windows/macOS sometimes writes a lockfile WITHOUT the other platforms' optional native packages
 * (`@rolldown/binding-linux-x64-gnu`, `lightningcss-linux-x64-musl`, …). Such a lockfile installs fine on
 * the author's machine and then fails, or silently falls back to slow/wasm builds, on Linux. Rule: every
 * Linux x64 (glibc + musl) `optionalDependencies` entry of every package must resolve to an entry in the
 * lockfile (see isRequiredLinuxBinding).
 */
export const checkLockfileInstallableOnLinux = (lockfile: unknown): LinuxInstallabilityResult => {
  if (!isLockfile(lockfile)) {
    return { ok: false, missing: [{ package: "", binding: "(not a lockfileVersion 2+ package-lock.json)" }] };
  }
  const missing: MissingLinuxBinding[] = [];
  for (const [lockPath, entry] of Object.entries(lockfile.packages)) {
    if (entry.link) continue;
    for (const binding of Object.keys(entry.optionalDependencies ?? {})) {
      if (!isRequiredLinuxBinding(binding)) continue;
      if (!resolveLockfileDependency(lockfile.packages, lockPath, binding)) {
        missing.push({ package: lockPath, binding });
      }
    }
  }
  return { ok: missing.length === 0, missing };
};
